<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify your email</title>
</head>
<body style="margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; line-height: 1.5; color: #1a1a1a;">
  <div style="max-width: 560px; margin: 0 auto; padding: 24px;">
    <h1 style="margin: 0 0 16px; font-size: 24px; font-weight: 600;">Verify your email</h1>
    {{#if firstName}}
    <p style="margin: 0 0 24px;">Hi {{firstName}},</p>
    {{else}}
    <p style="margin: 0 0 24px;">Hi,</p>
    {{/if}}
    <p style="margin: 0 0 24px;">Thanks for signing up. {{#if verifyLink}}Use the button below to verify your email and activate your account.{{else}}Use the verification code below with the verify-email step on the storefront.{{/if}}</p>
    {{#if verifyLink}}
    <p style="margin: 0 0 24px;">
      <a href="{{verifyLink}}" style="display: inline-block; padding: 12px 24px; background: #1a1a1a; color: #fff; text-decoration: none; border-radius: 6px; font-weight: 500;">Verify email</a>
    </p>
    <p style="margin: 0 0 24px; font-size: 14px; color: #666;">Or copy this link: <a href="{{verifyLink}}" style="color: #1a1a1a; word-break: break-all;">{{verifyLink}}</a></p>
    {{else}}
    {{#if token}}
    <p style="margin: 0 0 24px; font-size: 14px; color: #666;">Your verification token:</p>
    <p style="margin: 0 0 24px; font-family: monospace; font-size: 14px; background: #f4f4f4; padding: 12px; border-radius: 6px; word-break: break-all;">{{token}}</p>
    {{/if}}
    {{/if}}
    {{#if expiresAt}}
    <p style="margin: 0 0 24px; font-size: 14px; color: #666;">This link expires on {{expiresAt}}.</p>
    {{/if}}
    <p style="margin: 0; font-size: 14px; color: #666;">If you didn’t create an account, you can ignore this email.</p>
  </div>
</body>
</html>
